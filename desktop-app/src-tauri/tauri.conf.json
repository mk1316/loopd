{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "loopd",
  "version": "0.1.0",
  "identifier": "dev.loopd.desktop",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && npm run export"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "loopd",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:usage.db"]
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/mk1316/loopd/releases/latest/download/{{target}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGRjM5QjY4QjE5QjY4QjE5CmlkOiA4RkYzOUI2OEIxOUI2OEIxOQo="
    }
  }
}
